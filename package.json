{
  "name": "claimsathi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "workspaces": [
    "contracts",
    "rules",
    "api",
    "worker",
    "jobs",
    "web"
  ],
  "scripts": {
